[Unit]
Description=Nexari Platform daily PostgreSQL backup

[Timer]
# Run daily at 03:00 UTC with up to 30-min random jitter to avoid thundering herd
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=1800
# Run immediately on next opportunity if a scheduled run was missed (e.g. server was down)
Persistent=true

[Install]
WantedBy=timers.target
